# LLM for script generation (pick one, code supports switching via DEFAULT_LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic   # or "openai"

# Text-to-speech
ELEVENLABS_API_KEY=

# Image + video generation (aggregator — one key covers many models)
FAL_API_KEY=
KREA_API_KEY=
# Optional; defaults to ./data/krea_asset_cache.json
KREA_ASSET_CACHE_FILE=./data/krea_asset_cache.json

# App config
APP_PORT=8420
PROJECTS_DIR=./data/projects
CHARACTERS_DIR=./data/characters
DATABASE_URL=sqlite:///./data/app.db

# When true (default), stages that lack an API key fall back to offline
# placeholder generation so the full pipeline is runnable without any keys.
ALLOW_OFFLINE_FALLBACK=true

JAMENDO_CLIENT_ID=

# TikTok publishing (Login Kit + Content Posting API). See TIKTOK_SETUP.md.
# One developer app (https://developers.tiktok.com) authorizes many creator
# accounts; per-account tokens are stored in the database, not here.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Must be an absolute https URL registered on the app — TikTok rejects http and
# localhost. Point it at /api/tiktok/link/callback on whatever https host fronts
# this app (tunnel or deployed domain); without one, use the paste-URL fallback
# in Settings -> TikTok publishing.
TIKTOK_REDIRECT_URI=
# Only for apps registered as desktop clients (adds the PKCE challenge).
TIKTOK_USE_PKCE=false

# YouTube publishing (Google OAuth + Data API v3).
# One Google Cloud OAuth client authorizes many channels; per-channel tokens are
# stored in the database, not here. See YOUTUBE_SETUP.md for how to get these.
YOUTUBE_CLIENT_ID=
YOUTUBE_CLIENT_SECRET=
# Optional. Defaults to http://localhost:<APP_PORT>/api/youtube/link/callback —
# Google allows http on localhost, so no tunnel is needed. Whatever is used here
# must be registered on the OAuth client verbatim.
YOUTUBE_REDIRECT_URI=
