# LLM for script generation (pick one, code supports switching via DEFAULT_LLM_PROVIDER)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEFAULT_LLM_PROVIDER=anthropic   # or "openai"

# Text-to-speech
ELEVENLABS_API_KEY=

# Image + video generation (aggregator — one key covers many models)
FAL_API_KEY=

# App config
APP_PORT=8420
PROJECTS_DIR=./data/projects
CHARACTERS_DIR=./data/characters
DATABASE_URL=sqlite:///./data/app.db

# When true (default), stages that lack an API key fall back to offline
# placeholder generation so the full pipeline is runnable without any keys.
ALLOW_OFFLINE_FALLBACK=true

JAMENDO_CLIENT_ID=